        <!-- ======================= MAIN ======================= -->
        <div class="min-w-0 space-y-5">

            <!-- Metrics -->
            <section id="metricsCard"
                     class="rounded-xl border border-ink-700 bg-ink-850/60 p-5 transition-opacity">
                <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <h2 class="text-xs font-bold uppercase tracking-widest text-slate-400">
                            Execution Metrics
                        </h2>
                        <p id="algorithmUsed" class="mt-1 font-mono text-xs text-accent">
                            awaiting input
