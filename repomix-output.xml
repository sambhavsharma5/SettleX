package com.settlex.engine.support;

import java.util.ArrayList;
import java.util.List;

/**
 * Exact solver for the NP-hard <em>maximum zero-sum partition</em> problem.
 *
 * <p><strong>The problem.</strong> Given {@code N} participants with net balances summing to
 * zero, partition them into the maximum possible number {@code k} of pairwise disjoint
 * subsets, each of which individually sums to zero. Every such subset is an independent
 * island: money never needs to cross between islands.</p>
 *
 * <p><strong>Why it matters.</strong> Settling an island of size {@code m} requires at
 * least {@code m - 1} transfers — {@code m} settlements would be needed only if nothing
 * ever nets to zero, which cannot happen when the island balances. Summing over islands,
 * the provable lower bound on any settlement is:</p>
 *
 * <pre>{@code  minimum transfers = Σ (|S_i| - 1) = N - k }</pre>
 *
 * <p>so maximising {@code k} minimises the transfer count. Since {@code k >= 1} always,
 * this bound is never worse than the greedy heuristic's {@code N - 1}.</p>
 *
 * <p><strong>The algorithm.</strong> Bitmask dynamic programming. For a subset {@code mask}
 * whose balances sum to zero, {@code dp[mask]} is the maximum number of zero-sum groups it
 * decomposes into:</p>
 *
 * <pre>{@code
 *   dp[0]     = 0
 *   dp[mask]  = 1 + max( dp[mask \ sub] )   over proper submasks sub of mask
 *                                          that contain mask's lowest set bit
 *                                          and satisfy sum[sub] == 0
 * }</pre>
 *
 * <p>Requiring {@code sub} to contain the lowest set bit is the standard symmetry break: it
 * prevents counting the same partition in many orders, and because {@code sub} is a strict
 * subset containing a bit below every other bit of the remainder, {@code mask \ sub < mask}
 * numerically — so a single ascending pass over masks suffices, with no recursion and no
 * memoisation overhead.</p>
 *
 * <p><strong>Complexity.</strong> {@code O(3^N / 2)} time and {@code O(2^N)} space. At
 * {@code N = 16} that is roughly 21.5 million inner iterations and two 65 536-element
 * tables, which runs comfortably inside a request budget. {@code N > 16} is refused; the
 * caller degrades to the greedy heuristic.</p>
 *
 * <p>The DP is exact and deterministic: given the same input it returns the same partition,
 * because mask iteration is ascending and ties keep the first candidate found.</p>
 */
public final class BitmaskPartitionSolver {

    /**
     * Default participant ceiling for the exact solver. {@code 2^16 = 65 536} states is the
     * practical ceiling for an in-memory request-scoped solver.
     */
    public static final int DEFAULT_MAX_PARTICIPANTS = 16;

    /** Absolute ceiling, guarding against {@code 1 << n} overflow. Bit 31 would go negative. */
    private static final int HARD_MATHEMATICAL_LIMIT = 30;

    private BitmaskPartitionSolver() {
        throw new AssertionError("Utility class");
    }

    /**
     * Outcome of an exact partition run.
     *
     * @param groups          the discovered zero-sum subsets; every element of {@code groups}
     *                        sums to zero and they are pairwise disjoint and exhaustive
     * @param groupCount      {@code k}, the maximum number of zero-sum subsets
     * @param theoreticalMinimum  {@code N - k}, the provable minimum transfer count
     * @param statesEvaluated number of bitmask states materialised, {@code 2^N}
     * @param transitionsExamined number of candidate submasks considered across all states
     */
    public record Partition(
            List<List<Position>> groups,
            int groupCount,
            int theoreticalMinimum,
            int statesEvaluated,
            long transitionsExamined
    ) {
        public Partition {
            groups = List.copyOf(groups);
        }
    }

    /** {@code true} when the exact solver is willing to attempt this participant count. */
    public static boolean isWithinExactLimit(int participantCount, int maxParticipants) {
        return participantCount >= 0
                && participantCount <= maxParticipants
                && participantCount <= HARD_MATHEMATICAL_LIMIT;
    }

    /**
     * Finds a maximum-cardinality partition of {@code positions} into zero-sum subsets.
     *
     * @param positions participants with non-zero net balances; their balances must sum to zero
     * @return the optimal partition together with its accounting
     * @throws IllegalArgumentException if the participant count is beyond the mathematical
     *                                  limit, or the balances do not sum to zero
     */
    public static Partition solve(List<Position> positions) {
        int n = positions.size();
        if (n == 0) {
            return new Partition(List.of(), 0, 0, 1, 0L);
        }
        if (n > HARD_MATHEMATICAL_LIMIT) {
            throw new IllegalArgumentException(
                    "Bitmask solver supports at most " + HARD_MATHEMATICAL_LIMIT
                            + " participants, received " + n);
        }

        long[] balances = new long[n];
        for (int i = 0; i < n; i++) {
            balances[i] = positions.get(i).balance();
        }

        int stateCount = 1 << n;
        int fullMask = stateCount - 1;

        // sum[mask]: exact net balance of the participants selected by mask.
        long[] sum = new long[stateCount];
        for (int mask = 1; mask < stateCount; mask++) {
            int lowBit = mask & -mask;
            int index = Integer.numberOfTrailingZeros(lowBit);
            sum[mask] = sum[mask ^ lowBit] + balances[index];
        }

        if (sum[fullMask] != 0L) {
            throw new IllegalArgumentException(
                    "Cannot partition a ledger whose balances do not sum to zero (residual "
                            + MoneyMath.formatMinorUnits(sum[fullMask]) + ")");
        }

        int[] dp = new int[stateCount];
        int[] choice = new int[stateCount];
        long transitions = 0L;

        for (int mask = 1; mask < stateCount; mask++) {
            // A mask with non-zero balance cannot itself be a union of zero-sum groups.
            if (sum[mask] != 0L) {
                continue;
            }

            // The whole mask is always a valid single group, since its sum is zero.
            int best = 1;
            int bestSub = mask;

            // Symmetry break: only consider groups containing the lowest set bit.
            int lowBit = mask & -mask;
            int rest = mask ^ lowBit;
            for (int sub = rest; sub != 0; sub = (sub - 1) & rest) {
                int group = sub | lowBit;
                if (sum[group] != 0L) {
                    continue;
                }
                int remainder = dp[mask ^ group];
                if (remainder < 0) {
                    continue;
                }
                int candidate = remainder + 1;
                if (candidate > best) {
                    best = candidate;
                    bestSub = group;
                }
            }
            transitions += Long.bitCount(rest);

            dp[mask] = best;
            choice[mask] = bestSub;
        }

        List<List<Position>> groups = new ArrayList<>(dp[fullMask]);
        int remaining = fullMask;
        while (remaining != 0) {
            int group = choice[remaining];
            if (group == 0) {
                throw new IllegalStateException(
                        "Partition reconstruction stalled at mask " + remaining);
            }
            List<Position> members = new ArrayList<>(Integer.bitCount(group));
            for (int i = 0; i < n; i++) {
                if ((group & (1 << i)) != 0) {
                    members.add(positions.get(i));
                }
            }
            groups.add(members);
            remaining ^= group;
        }

        int groupCount = dp[fullMask];
        return new Partition(groups, groupCount, n - groupCount, stateCount, transitions);
    }

    /**
     * Computes only {@code k}, the maximum number of zero-sum subsets, without materialising
     * the partition. Used by the greedy engine to decide whether its own heuristic answer
     * happened to be provably minimal.
     */
    public static int maximumZeroSumSubsetCount(List<Position> positions) {
        return solve(positions).groupCount();
    }
}
</file>

<file path="src/main/java/com/settlex/engine/support/LedgerNormalizer.java">
package com.settlex.engine.support;

import com.settlex.dto.Transaction;
import com.settlex.exception.CurrencyPrecisionException;
import com.settlex.exception.UnbalancedLedgerException;

import java.math.BigDecimal;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

/**
 * Turns a raw {@code List<Transaction>} into a validated {@link SettlementProblem}.
 *
 * <p>This is the single place where {@link Transaction} values become trusted numbers.
 * Both engines delegate here, which guarantees they cannot drift apart in how they
 * interpret input.</p>
 *
 * <p>The normalisation pipeline is:</p>
 * <ol>
 *   <li>reject blank participant names;</li>
 *   <li>round every amount to two decimals with {@code HALF_EVEN} and convert to exact
 *       minor units;</li>
 *   <li>assert the ledger balances to exactly zero;</li>
 *   <li>net every participant, dropping those whose balance lands on zero.</li>
 * </ol>
 *
 * <p>Self-referential obligations ({@code A owes A}) are deliberately <em>accepted</em>
 * rather than rejected: they debit and credit the same participant, so they net to exactly
 * zero and vanish during step four. Rejecting them would be over-restrictive, because such
 * edges are a common artefact of imperfect bookkeeping and are economically inert.</p>
 */
public final class LedgerNormalizer {

    private static final BigDecimal ZERO_AMOUNT = BigDecimal.ZERO;

    private LedgerNormalizer() {
        throw new AssertionError("Utility class");
    }

    /**
     * Validates and nets out a raw transaction list.
     *
     * @throws IllegalArgumentException    if the list is null or empty, or a participant name is blank
     * @throws CurrencyPrecisionException  if an amount is sub-cent, out of range, or the aggregate overflows
     * @throws UnbalancedLedgerException    if debits and credits do not agree exactly
     */
    public static SettlementProblem normalize(List<Transaction> transactions) {
        if (transactions == null || transactions.isEmpty()) {
            throw new IllegalArgumentException("At least one transaction is required");
        }

        // LinkedHashMap: first-seen participant order, so every downstream artifact is stable.
        Map<String, Long> balances = new LinkedHashMap<>();
        long totalDebits = 0L;
        long totalCredits = 0L;

        for (int i = 0; i < transactions.size(); i++) {
            Transaction tx = transactions.get(i);
            String debtor = requireParticipant(tx.debtor(), i, "debtor");
            String creditor = requireParticipant(tx.creditor(), i, "creditor");

            long minor = MoneyMath.toMinorUnits(
                    tx.amount() == null ? BigDecimal.ZERO : tx.amount(), i, "amount");

            final int index = i;
            final BigDecimal amount = tx.amount();

            if (totalDebits > MoneyMath.MAX_LEDGER_TOTAL_MINOR) {
                throw new CurrencyPrecisionException(index, "amount",
                        amount.toPlainString(),
                        "aggregate ledger value exceeds the supported maximum of "
                                + MoneyMath.MAX_LEDGER_TOTAL.toPlainString());
            }

            totalDebits = addExact(totalDebits, minor, index, amount);
            totalCredits = addExact(totalCredits, minor, index, amount);

            // Net = Σ(credits) - Σ(debits)
            balances.merge(debtor, -minor, (a, b) -> addExact(a, b, index, amount));
            balances.merge(creditor, minor, (a, b) -> addExact(a, b, index, amount));
        }

        /*
         * Invariant guard. The Transaction model is bilateral, so gross debits always equal
         * gross credits and the net positions must cancel exactly. A non-zero residual here
         * would mean the netting logic is broken, which would silently corrupt every plan,
         * so it is asserted rather than assumed.
         */
        long residual = 0L;
        for (Long balance : balances.values()) {
            residual = addExact(residual, balance, 0, ZERO_AMOUNT);
        }
        if (residual != 0L) {
            throw new UnbalancedLedgerException(residual);
        }

        List<Position> positions = new ArrayList<>(balances.size());
        List<Position> creditors = new ArrayList<>();
        List<Position> debtors = new ArrayList<>();
        Map<String, BigDecimal> netBalances = new LinkedHashMap<>();

        for (Map.Entry<String, Long> entry : balances.entrySet()) {
            long balance = entry.getValue();
            netBalances.put(entry.getKey(), MoneyMath.fromMinorUnits(balance));
            if (balance != 0L) {
                Position position = new Position(entry.getKey(), balance);
                positions.add(position);
                if (position.isCreditor()) {
                    creditors.add(position);
                } else {
                    debtors.add(position);
                }
            }
        }

        return new SettlementProblem(positions, creditors, debtors, netBalances,
                transactions.size(), totalDebits);
    }

    private static long addExact(long accumulator, long delta, int index, BigDecimal amount) {
        try {
            return Math.addExact(accumulator, delta);
        } catch (ArithmeticException overflow) {
            throw new CurrencyPrecisionException(index, "amount",
                    String.valueOf(amount),
                    "aggregate ledger value overflows the supported magnitude");
        }
    }

    private static String requireParticipant(String value, int index, String field) {
        if (value == null || value.isBlank()) {
            throw new IllegalArgumentException(
                    "transactions[" + index + "]." + field + " must not be blank");
        }
        return value.trim();
    }
}
</file>

<file path="src/main/java/com/settlex/engine/support/MoneyMath.java">
package com.settlex.engine.support;

import com.settlex.exception.CurrencyPrecisionException;

import java.math.BigDecimal;
import java.math.RoundingMode;

/**
 * Central authority for every currency operation performed by the engines.
 *
 * <p>All settlement arithmetic is done in {@code long} minor units (cents) so that the
 * zero-sum detection in the bitmask solver is <em>exact</em> — no {@code BigDecimal}
 * comparison, no floating-point drift. {@link BigDecimal} is used only at the API boundary
 * for parsing and rendering.</p>
 *
 * <p>Scale is fixed at {@value #SCALE} decimals with {@link RoundingMode#HALF_EVEN}, the
 * banker's rounding mode, so that ties land on the nearest even cent and repeated
 * aggregation of half-cent values does not systematically drift upward.</p>
 */
public final class MoneyMath {

    /** Number of decimal places retained for all monetary values. */
    public static final int SCALE = 2;

    /** Rounding mode applied to every currency computation. */
    public static final RoundingMode ROUNDING_MODE = RoundingMode.HALF_EVEN;

    /** Multiplier converting major units to minor units. */
    static final BigDecimal MINOR_UNIT_SCALE = BigDecimal.valueOf(100L);

    /**
     * Upper bound on a single normalized amount, in major units. Chosen so that the minor
     * unit representation ({@code amount * 100}) stays comfortably inside {@code long}
     * range even after summing thousands of obligations.
     */
    public static final BigDecimal MAX_AMOUNT = new BigDecimal("1000000000000.00"); // 1e12

    /** Upper bound on the aggregate absolute value of a ledger, in major units. */
    public static final BigDecimal MAX_LEDGER_TOTAL = new BigDecimal("900000000000000.00"); // 9e14

    /** {@link #MAX_LEDGER_TOTAL} pre-converted to minor units for hot-loop range checks. */
    static final long MAX_LEDGER_TOTAL_MINOR = MAX_LEDGER_TOTAL.movePointRight(SCALE).longValueExact();

    private MoneyMath() {
        throw new AssertionError("Utility class");
    }

    /**
     * Rounds an amount onto the canonical currency scale using {@code HALF_EVEN}.
     *
     * @param amount value to normalize; must not be {@code null}
     * @return amount at two decimal places
     */
    public static BigDecimal normalize(BigDecimal amount) {
        return amount.setScale(SCALE, ROUNDING_MODE);
    }

    /**
     * Converts a monetary amount to exact minor units (cents).
     *
     * @throws CurrencyPrecisionException if the value cannot be represented without silent
     *                                     loss of precision or overflows {@code long}
     */
    public static long toMinorUnits(BigDecimal amount, int index, String field) {
        BigDecimal normalized = normalize(amount);

        if (normalized.signum() == 0) {
            throw new CurrencyPrecisionException(index, field, amount.toPlainString(),
                    "amount is below the smallest representable currency unit ("
                            + "0." + "0".repeat(SCALE) + ") once rounded with " + ROUNDING_MODE);
        }
        if (normalized.abs().compareTo(MAX_AMOUNT) > 0) {
            throw new CurrencyPrecisionException(index, field, amount.toPlainString(),
                    "amount exceeds the supported maximum of " + MAX_AMOUNT.toPlainString());
        }

        BigDecimal minor = normalized.movePointRight(SCALE);
        if (minor.abs().compareTo(BigDecimal.valueOf(Long.MAX_VALUE)) > 0) {
            throw new CurrencyPrecisionException(index, field, amount.toPlainString(),
                    "amount overflows the 64-bit minor-unit representation");
        }
        return minor.longValueExact();
    }

    /** Renders minor units (cents) back into a two-decimal-place {@link BigDecimal}. */
    public static BigDecimal fromMinorUnits(long minorUnits) {
        return BigDecimal.valueOf(minorUnits, SCALE);
    }

    /** Renders minor units as plain text, e.g. {@code -12345 -> "-123.45"}. */
    public static String formatMinorUnits(long minorUnits) {
        return fromMinorUnits(minorUnits).toPlainString();
    }

    /** Converts nanoseconds to microseconds with two decimal places. */
    public static double nanosToMicros(long nanos) {
        return BigDecimal.valueOf(nanos)
                .divide(BigDecimal.valueOf(1_000L))
                .setScale(SCALE, ROUNDING_MODE)
                .doubleValue();
    }
}
</file>

<file path="src/main/java/com/settlex/engine/support/PlanAssembler.java">
package com.settlex.engine.support;

import com.settlex.dto.Settlement;
import com.settlex.dto.SettlementPlan;

import java.math.BigDecimal;
import java.util.List;
import java.util.Map;

/**
 * Builds the {@link SettlementPlan} returned by every engine, so that reported metrics are
 * computed identically no matter which algorithm produced the settlements.
 *
 * <p>All monetary totals are accumulated in {@code long} minor units and converted once, at
 * the boundary, which keeps the arithmetic exact regardless of how many settlements a run
 * produced.</p>
 */
public final class PlanAssembler {

    private PlanAssembler() {
        throw new AssertionError("Utility class");
    }

    /**
     * @param problem            the validated problem the engine solved
     * @param settlements        the produced transfers
     * @param elapsedNanos       engine wall-clock time
     * @param algorithm          algorithm identifier for the response
     * @param groupCount         {@code k} for the exact solver; the implicitly achieved group
     *                           count for the greedy solver
     * @param lowerBound         provable minimum transfer count, or {@code -1} when unknown
     * @param fallback           whether the exact solver degraded to the heuristic
     * @param islands            discovered zero-sum components as participant names
     * @param provablyOptimal    whether the transfer count is known to be minimal
     */
    public static SettlementPlan assemble(SettlementProblem problem,
                                          List<Settlement> settlements,
                                          long elapsedNanos,
                                          String algorithm,
                                          int groupCount,
                                          int lowerBound,
                                          boolean fallback,
                                          List<List<String>> islands,
                                          boolean provablyOptimal) {

        long cashFlowAfterMinor = 0L;
        for (Settlement settlement : settlements) {
            cashFlowAfterMinor = Math.addExact(cashFlowAfterMinor,
                    settlement.amount().movePointRight(MoneyMath.SCALE).longValueExact());
        }

        int initial = problem.initialTransactionCount();
        int optimized = settlements.size();

        return new SettlementPlan(
                List.copyOf(settlements),
                initial,
                optimized,
                SettlementPlan.reductionPercentage(initial, optimized),
                MoneyMath.fromMinorUnits(problem.totalCashFlow()),
                MoneyMath.fromMinorUnits(cashFlowAfterMinor),
                elapsedNanos,
                algorithm,
                Map.copyOf(problem.netBalances()),
                provablyOptimal,
                fallback,
                problem.netBalances().size(),
                groupCount,
                lowerBound,
                List.copyOf(islands));
    }

    /** Total cash moved by a settlement list, in major units. */
    public static BigDecimal totalCashFlow(List<Settlement> settlements) {
        long minor = 0L;
        for (Settlement settlement : settlements) {
            minor = Math.addExact(minor,
                    settlement.amount().movePointRight(MoneyMath.SCALE).longValueExact());
        }
        return MoneyMath.fromMinorUnits(minor);
    }
}
