<file path="src/main/java/com/settlex/engine/support/Position.java">
package com.settlex.engine.support;

import java.math.BigDecimal;
import java.util.Comparator;

/**
 * A participant's net position, expressed in exact minor units (cents).
 *
 * <p>Sign convention follows the specification: {@code Net = Σ(credits) - Σ(debits)}.
 * A positive balance means the participant is a <em>creditor</em> awaiting money; a
 * negative balance means a <em>debtor</em> who must pay.</p>
 *
 * <p>Participants whose net balance settles to exactly zero are eliminated entirely — they
 * neither pay nor receive, so including them would only inflate the theoretical minimum.</p>
 *
 * @param participant display name of the party
 * @param balance     signed net position in minor units; never zero
 */
public record Position(String participant, long balance) {

    /**
     * Orders by descending absolute exposure, breaking ties alphabetically. Using a total
     * order is what makes both engines fully deterministic: two runs over identical input
     * always produce byte-identical settlement lists.
     */
    public static final Comparator<Position> BY_MAGNITUDE_DESC = Comparator
            .comparingLong((Position p) -> Math.abs(p.balance()))
            .thenComparing(Position::participant)
            .reversed();

    public Position {
        if (balance == 0L) {
            throw new IllegalArgumentException(
                    "Position for '" + participant + "' has a zero balance; zero-balance "
                            + "participants must be excluded before constructing positions");
        }
    }

    public boolean isCreditor() {
        return balance > 0L;
    }

    public boolean isDebtor() {
        return balance < 0L;
    }

    /** Amount this participant is owed, in minor units. Zero for debtors. */
    public long credit() {
        return Math.max(balance, 0L);
    }

    /** Amount this participant owes, in minor units, always non-negative. */
    public long debt() {
        return Math.abs(Math.min(balance, 0L));
    }

    /**
     * Returns this position with {@code settled} minor units knocked off, or {@code null}
     * when the residual is exactly zero. Callers must handle {@code null} by simply not
     * re-queueing the participant — there is no remaining exposure to settle.
     *
     * <p>Implemented by subtracting from the magnitude and then restoring the original sign.
     * That framing matters: a creditor's balance is {@code +c} and settles to {@code c - s},
     * whereas a debtor's balance is {@code -d} and settles to {@code -(d - s)}. Writing it
     * as a plain {@code balance - settled} is correct for the first case and silently
     * doubles the debt in the second, so the sign is reapplied explicitly instead.</p>
     *
     * @param settled minor units to remove; must be strictly positive and must not exceed the
     *                magnitude of {@link #balance()}
     * @throws IllegalArgumentException if {@code settled} is not positive or exceeds the
     *                                  outstanding exposure
     * @throws ArithmeticException     if the caller attempts to settle more than is owed,
     *                                  which would flip the participant to the wrong side
     */
    public Position reduce(long settled) {
        if (settled <= 0L) {
            // Settling nothing is never meaningful and would hand back an identical position.
            // A greedy caller that re-queues such a position loops forever, so this is an
            // invariant of the algorithm rather than an input concern.
            throw new IllegalArgumentException(
                    "Cannot settle a non-positive amount: " + settled);
        }

        long magnitude = Math.abs(balance);
        if (settled > magnitude) {
            throw new IllegalArgumentException(
                    "Cannot settle " + MoneyMath.formatMinorUnits(settled)
                            + " against an outstanding exposure of only "
                            + MoneyMath.formatMinorUnits(magnitude)
                            + " for '" + participant + "'");
        }

        long residual = magnitude - settled;
        if (residual == 0L) {
            return null;
        }
        return new Position(participant, isCreditor() ? residual : -residual);
    }

    /** This position rendered as a two-decimal-place {@link BigDecimal}. */
    public BigDecimal asMoney() {
        return MoneyMath.fromMinorUnits(balance);
    }

    @Override
    public String toString() {
        return participant + "=" + MoneyMath.formatMinorUnits(balance);
    }
}
</file>

<file path="src/main/java/com/settlex/engine/support/SettlementProblem.java">
package com.settlex.engine.support;

import java.math.BigDecimal;
import java.util.List;
import java.util.Map;

/**
 * An immutable, pre-validated settlement problem handed to an engine.
 *
 * <p>Building one of these is where every precondition is enforced — balance check,
 * self-obligation rejection, currency precision. Once a {@code SettlementProblem} exists,
 * an engine can assume the ledger is well-posed and work purely in minor units.</p>
 *
 * @param positions            every participant with a non-zero net balance, in first-seen
 *                             order (deterministic iteration for both engines)
 * @param creditors            the creditor half, as a stable snapshot list
 * @param debtors              the debtor half, as a stable snapshot list
 * @param netBalances          participant to net position in major units, including
 *                             participants that netted out to exactly zero
 * @param initialTransactionCount number of raw obligations
 * @param totalCashFlow        sum of all obligation amounts in minor units
 */
public record SettlementProblem(
        List<Position> positions,
        List<Position> creditors,
        List<Position> debtors,
        Map<String, BigDecimal> netBalances,
        int initialTransactionCount,
        long totalCashFlow
) {

    public SettlementProblem {
        positions = List.copyOf(positions);
        creditors = List.copyOf(creditors);
        debtors = List.copyOf(debtors);
        netBalances = Map.copyOf(netBalances);
    }

    /** Number of participants carrying a non-zero net balance. */
    public int activeParticipantCount() {
        return positions.size();
    }

    /** Number of participants that netted out to exactly zero. */
    public int settledParticipantCount() {
        return netBalances.size() - positions.size();
    }

    /** Total exposure owed by debtors, in minor units. Equals total creditor credit. */
    public long totalOutstandingMinor() {
        long total = 0L;
        for (Position debtor : debtors) {
            total += debtor.debt();
        }
        return total;
    }
}
</file>

<file path="src/main/java/com/settlex/engine/GreedyPriorityQueueEngine.java">
package com.settlex.engine;

import com.settlex.config.SettleXProperties;
import com.settlex.dto.OptimizationStrategy;
import com.settlex.dto.Settlement;
import com.settlex.dto.SettlementPlan;
import com.settlex.dto.Transaction;
import com.settlex.engine.support.BitmaskPartitionSolver;
import com.settlex.engine.support.LedgerNormalizer;
import com.settlex.engine.support.MoneyMath;
import com.settlex.engine.support.PlanAssembler;
import com.settlex.engine.support.Position;
import com.settlex.engine.support.SettlementProblem;
import com.settlex.exception.UnsupportedStrategyException;
import org.springframework.stereotype.Component;

import java.util.ArrayList;
import java.util.List;
import java.util.PriorityQueue;

/**
 * Greedy max-heap settlement: repeatedly match the largest debtor against the largest
 * creditor until every exposure is extinguished.
 *
 * <p><strong>Algorithm.</strong> Net balances are split into two {@link PriorityQueue}s that
 * behave as max-heaps (a {@code PriorityQueue} is a min-heap, so the comparator is reversed).
 * Each round pops one creditor and one debtor and transfers the lesser of the two
 * exposures, re-queueing whichever side survives.</p>
 *
 * <p><strong>Guarantees.</strong> Every round fully discharges at least one participant, so
 * the run terminates in at most {@code N - 1} transfers for {@code N} participants — the
 * classical result that any zero-sum ledger can be settled with at most {@code N - 1}
 * transactions. Time complexity is {@code O(N log N)}: {@code O(N)} rounds, each doing a
 * constant number of {@code O(log N)} heap operations.</p>
 *
 * <p><strong>What it does not guarantee.</strong> Optimality. Greedy is blind to the island
 * structure: given {@code [100, 100, -100, -100]} it settles 200 in two transfers where
 * 100 + 100 is achievable by pairing each debtor with one creditor. This engine therefore
 * reports {@code isMathematicallyOptimal} only after verifying its answer against the exact
 * bound {@code N - k} — and only when {@code N} is small enough for that bound to be
 * computable.</p>
 *
 * <p>The settlement core is exposed as {@link #settleGroup} so
 * {@link OptimalSubsetPartitionEngine} can apply the same deterministic inner routine
 * inside each island it discovers.</p>
 */
@Component
public class GreedyPriorityQueueEngine implements SettlementEngine {

    /** Reported as {@code algorithmUsed}. */
    public static final String ALGORITHM_NAME = "Greedy Priority-Queue Heuristic";

    private final SettleXProperties properties;

    public GreedyPriorityQueueEngine(SettleXProperties properties) {
        this.properties = properties;
    }

    @Override
    public OptimizationStrategy supportedStrategy() {
        return OptimizationStrategy.GREEDY;
    }

    @Override
    public String name() {
        return ALGORITHM_NAME;
    }

    @Override
    public SettlementPlan minimize(List<Transaction> transactions, OptimizationStrategy strategy) {
        if (strategy != supportedStrategy()) {
            throw new UnsupportedStrategyException(ALGORITHM_NAME, String.valueOf(strategy),
                    supportedStrategy().name());
        }

        long startNanos = System.nanoTime();
        SettlementProblem problem = LedgerNormalizer.normalize(transactions);
        List<Settlement> settlements = settleGroup(problem.creditors(), problem.debtors());
        long elapsedNanos = System.nanoTime() - startNanos;

        /*
         * Optimality is a claim about optimality, not about intent, so it is verified rather
         * than assumed. When the ledger is small enough, the exact bitmask solver supplies
         * the lower bound N - k; the heuristic is optimal precisely when it matched it.
         */
        int participantCount = problem.activeParticipantCount();
        int exactLimit = properties.engine().exactSolverMaxParticipants();

        int lowerBound = -1;
        int groupCount = countDoubleClears(problem.creditors(), problem.debtors(), settlements.size());
        boolean provablyOptimal;

        if (BitmaskPartitionSolver.isWithinExactLimit(participantCount, exactLimit)) {
            int k = BitmaskPartitionSolver.maximumZeroSumSubsetCount(problem.positions());
            lowerBound = participantCount - k;
            groupCount = k;
            provablyOptimal = settlements.size() == lowerBound;
        } else {
            // Beyond the exact solver's reach the minimum transfer count is unknown, so the
            // heuristic is explicitly reported as unproven rather than optimistically claimed.
            provablyOptimal = false;
        }

        return PlanAssembler.assemble(problem, settlements, elapsedNanos, ALGORITHM_NAME,
                groupCount, lowerBound, false, List.of(), provablyOptimal);
    }

    /**
     * The deterministic greedy settlement core.
     *
     * @param creditors participants with a positive net balance
     * @param debtors   participants with a negative net balance
     * @return transfers that fully extinguish every exposure; empty when both sides are empty
     * @throws IllegalStateException if the inputs are not balanced, which would indicate a
     *                               corruption upstream rather than a caller error
     */
    public static List<Settlement> settleGroup(List<Position> creditors, List<Position> debtors) {
        if (creditors.isEmpty() && debtors.isEmpty()) {
            return List.of();
        }

        // Fail fast on mis-signed input. This guard is load-bearing, not defensive noise: if a
        // creditor-side position carried a non-positive balance the transfer amount would be 0,
        // reduce(0) would return the very same position, and the loop below would re-queue it
        // forever, appending zero-value settlements until the heap was exhausted.
        requireCorrectlySigned(creditors, true);
        requireCorrectlySigned(debtors, false);

        // A PriorityQueue is a min-heap; reversing the total order turns it into a max-heap.
        PriorityQueue<Position> creditorHeap = new PriorityQueue<>(Position.BY_MAGNITUDE_DESC);
        PriorityQueue<Position> debtorHeap = new PriorityQueue<>(Position.BY_MAGNITUDE_DESC);
        creditorHeap.addAll(creditors);
        debtorHeap.addAll(debtors);

        List<Settlement> settlements = new ArrayList<>(creditors.size() + debtors.size() - 1);

        while (!creditorHeap.isEmpty() && !debtorHeap.isEmpty()) {
            Position creditor = creditorHeap.poll();
            Position debtor = debtorHeap.poll();

            // Transfer the smaller of the two exposures; the larger side survives.
            long amount = Math.min(creditor.credit(), debtor.debt());

            settlements.add(new Settlement(
                    debtor.participant(),
                    creditor.participant(),
                    MoneyMath.fromMinorUnits(amount)));

            Position residualCreditor = creditor.reduce(amount);
            Position residualDebtor = debtor.reduce(amount);
            if (residualCreditor != null) {
                creditorHeap.add(residualCreditor);
            }
            if (residualDebtor != null) {
                debtorHeap.add(residualDebtor);
            }
        }

        if (!creditorHeap.isEmpty() || !debtorHeap.isEmpty()) {
            throw new IllegalStateException(
                    "Greedy settlement terminated with unresolved exposure: "
                            + creditorHeap.size() + " creditor(s) and "
                            + debtorHeap.size() + " debtor(s) remain; the group is unbalanced");
        }

        return List.copyOf(settlements);
    }

    /**
     * Rejects positions that arrived on the wrong side of the settlement.
     *
     * @param side         the creditor or debtor side about to be settled
     * @param creditorSide {@code true} for the creditor side, {@code false} for the debtor side
     * @throws IllegalArgumentException if any position's sign contradicts its side
     */
    private static void requireCorrectlySigned(List<Position> side, boolean creditorSide) {
        // reversed() walks the caller's list back to front so the reported offenders appear in
        // the same order the caller supplied them, not in heap order.
        List<Position> misplaced = side.reversed().stream()
                .filter(position -> creditorSide != position.isCreditor())
                .toList();

        if (!misplaced.isEmpty()) {
            throw new IllegalArgumentException(
                    "Greedy settlement received " + misplaced.size() + " position(s) on the "
                            + (creditorSide ? "creditor" : "debtor") + " side requiring "
                            + (creditorSide ? "a positive" : "a negative")
                            + " balance: " + misplaced);
        }
    }

    /**
     * Number of rounds that simultaneously discharged a debtor and a creditor.
     *
     * <p>Each round discharges at least one participant and the final round discharges two,
     * so for {@code N} active participants and {@code m} transfers the number of
     * double-discharge rounds is exactly {@code N - m}. That is the group count the greedy
     * run implicitly achieved, and it is directly comparable to {@code k} from the exact
     * solver.</p>
     */
    static int countDoubleClears(List<Position> creditors, List<Position> debtors, int transfers) {
        int active = creditors.size() + debtors.size();
        return active - transfers;
    }
}
</file>

<file path="src/main/java/com/settlex/engine/OptimalSubsetPartitionEngine.java">
package com.settlex.engine;

import com.settlex.config.SettleXProperties;
import com.settlex.dto.OptimizationStrategy;
import com.settlex.dto.Settlement;
import com.settlex.dto.SettlementPlan;
import com.settlex.dto.Transaction;
import com.settlex.engine.support.BitmaskPartitionSolver;
import com.settlex.engine.support.LedgerNormalizer;
import com.settlex.engine.support.PlanAssembler;
import com.settlex.engine.support.Position;
import com.settlex.engine.support.SettlementProblem;
import com.settlex.exception.UnsupportedStrategyException;
import org.springframework.stereotype.Component;

import java.util.ArrayList;
import java.util.List;

/**
 * Exact minimum-transfer settlement via maximum zero-sum partitioning.
 *
 * <p>Where {@link GreedyPriorityQueueEngine} pairs exposures greedily and hopes for the best,
 * this engine first discovers the ledger's <em>independent islands</em> and only then settles.
 * Splitting the work correctly is what removes the transfers greedy cannot see.</p>
 *
 * <p><strong>Method.</strong></p>
 * <ol>
 *   <li>Net every participant and discard those at exactly zero.</li>
 *   <li>For {@code N <= 16}, run {@link BitmaskPartitionSolver} to find the maximum number
 *       {@code k} of disjoint zero-sum subsets — an exact, NP-hard subpartition solved in
 *       {@code O(3^N / 2)} time.</li>
 *   <li>Settle each island independently with the greedy routine. An island of size
 *       {@code m} costs exactly {@code m - 1} transfers, so the total is
 *       {@code Σ(m_i - 1) = N - k}.</li>
 * </ol>
 *
 * <p><strong>Optimality.</strong> Within a zero-sum island, every transfer discharges at
 * least one participant and the last discharges two, so no solution can use fewer than
 * {@code m - 1} transfers. Since islands are independent, the bound sums: {@code N - k} is a
 * true lower bound on <em>every</em> settlement of this ledger, and step 3 attains it.
 * The result is therefore provably minimal, not merely better than the heuristic.</p>
 *
 * <p><strong>Degradation.</strong> For {@code N > 16} the bitmask state space exceeds what
 * is tractable per request, so the engine transparently falls back to the greedy heuristic
 * and sets {@code isOptimalFallback = true}. Optimality is then reported as unproven
 * rather than claimed.</p>
 */
@Component
public class OptimalSubsetPartitionEngine implements SettlementEngine {

    /** Reported as {@code algorithmUsed} on a successful exact run. */
    public static final String ALGORITHM_NAME = "Optimal Zero-Sum Subpartition (Bitmask DP)";

    /** Reported when the participant count forced a fallback to the greedy heuristic. */
    public static final String FALLBACK_ALGORITHM_NAME =
            "Optimal Zero-Sum Subpartition (Bitmask DP) -> Greedy Priority-Queue Heuristic [N>limit]";

    private final SettleXProperties properties;

    public OptimalSubsetPartitionEngine(SettleXProperties properties) {
        this.properties = properties;
    }

    @Override
    public OptimizationStrategy supportedStrategy() {
        return OptimizationStrategy.OPTIMAL_SUBSET;
    }

    @Override
    public String name() {
        return ALGORITHM_NAME;
    }

    @Override
    public SettlementPlan minimize(List<Transaction> transactions, OptimizationStrategy strategy) {
        if (strategy != supportedStrategy()) {
            throw new UnsupportedStrategyException(ALGORITHM_NAME, String.valueOf(strategy),
                    supportedStrategy().name());
        }

        long startNanos = System.nanoTime();
        SettlementProblem problem = LedgerNormalizer.normalize(transactions);

        List<Position> active = problem.positions();
        int participantCount = active.size();
        int exactLimit = properties.engine().exactSolverMaxParticipants();

        List<List<Position>> islands;
        boolean fellBack;
        int lowerBound;

        if (BitmaskPartitionSolver.isWithinExactLimit(participantCount, exactLimit)) {
            BitmaskPartitionSolver.Partition partition = BitmaskPartitionSolver.solve(active);
            islands = partition.groups();
            lowerBound = partition.theoreticalMinimum();
            fellBack = false;
        } else {
            // Beyond the bitmask limit: treat the whole ledger as one island and let the
            // greedy routine handle it, which still yields the N-1 bound.
            islands = List.of(active);
            lowerBound = -1;
            fellBack = true;
        }

        /*
         * Settle each island strictly on its own. Merging islands before settling would
         * silently degrade this engine into the greedy heuristic, because greedy would then be
         * free to route money across an island boundary that should never be crossed.
         */
        List<Settlement> settlements = new ArrayList<>();
        List<List<String>> islandNames = new ArrayList<>(islands.size());

        for (List<Position> island : islands) {
            List<Position> islandCreditors = new ArrayList<>(island.size());
            List<Position> islandDebtors = new ArrayList<>(island.size());
            List<String> names = new ArrayList<>(island.size());

            for (Position position : island) {
                names.add(position.participant());
                if (position.isCreditor()) {
                    islandCreditors.add(position);
                } else {
                    islandDebtors.add(position);
                }
            }

            settlements.addAll(GreedyPriorityQueueEngine.settleGroup(islandCreditors, islandDebtors));
            islandNames.add(List.copyOf(names));
        }

        long elapsedNanos = System.nanoTime() - startNanos;

        /*
         * The DP-derived bound is a theorem about this ledger, so when the exact path ran it
         * must agree with what the greedy inner routine produced. A mismatch would mean the
         * two engines disagree about the same input, which must never pass silently.
         */
        if (!fellBack && settlements.size() != lowerBound) {
            throw new IllegalStateException(
                    "Exact solver produced " + settlements.size() + " transfers but the DP "
                            + "proves the minimum is " + lowerBound);
        }

        return PlanAssembler.assemble(problem, settlements, elapsedNanos,
                fellBack ? FALLBACK_ALGORITHM_NAME : ALGORITHM_NAME,
                islands.size(), lowerBound, fellBack, islandNames, !fellBack);
    }
}
</file>

<file path="src/main/java/com/settlex/engine/SettlementEngine.java">
package com.settlex.engine;

import com.settlex.dto.OptimizationStrategy;
import com.settlex.dto.SettlementPlan;
import com.settlex.dto.Transaction;

import java.util.List;

/**
 * Contract every settlement algorithm implements.
 *
 * <p>Implementations are required to be <strong>pure and deterministic</strong>: the same
 * transaction list must always yield an identical settlement list. That property is what
 * allows two engines to be benchmarked against each other and what makes the plan safe to
 * cache or diff.</p>
 *
 * <p>Implementations must be safe for concurrent use.</p>
 */
public interface SettlementEngine {

    /**
     * Computes a minimal set of transfers that discharges every obligation.
     *
     * @param transactions the raw obligation graph; must be non-empty, positively valued
     *                      and balanced
     * @param strategy     the strategy the caller wants applied; must equal
     *                      {@link #supportedStrategy()}
     * @return an immutable {@link com.settlex.dto.SettlementPlan}
     * @throws com.settlex.exception.UnsupportedStrategyException if the strategy is not this
     *                                                               engine's own
     * @throws com.settlex.exception.UnbalancedLedgerException    if debits and credits differ
     * @throws com.settlex.exception.CurrencyPrecisionException  if an amount cannot be
     *                                                               represented exactly
     */
    SettlementPlan minimize(List<Transaction> transactions, OptimizationStrategy strategy);

    /** The single strategy this engine implements. */
    OptimizationStrategy supportedStrategy();

    /** Stable, human-readable identifier reported as {@code algorithmUsed}. */
    default String name() {
        return getClass().getSimpleName();
    }
}
</file>

